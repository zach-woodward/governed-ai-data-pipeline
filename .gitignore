# virtualenv
.venv/

# runtime state: databases are per-install and hold (synthetic) record data
var/*.db
var/*.db-wal
var/*.db-shm

# the landing zone is a drop point, not content
data/landing/*
!data/landing/.gitkeep

# build + tooling artifacts
*.egg-info/
build/
dist/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
